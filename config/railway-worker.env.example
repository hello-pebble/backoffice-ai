# Railway → backoffice-worker 서비스 → Variables → Raw Editor 에 붙여 넣는 값입니다.
# 이 파일을 config/railway-worker.env 로 복사해 값을 채운 뒤 붙여 넣으세요(복사본은 커밋되지 않습니다).
#
# 워커는 DB 에 직접 쓰지 않습니다. 저장은 백엔드의 워커 전용 API 를 거치므로
# SUPABASE_* 변수는 더 이상 워커에 필요하지 않습니다(등록돼 있으면 지우세요).

# 결과를 넘길 백엔드 주소. Railway 내부 주소를 써도 됩니다.
BACKEND_API_URL=https://backoffice-ai-production.up.railway.app
# 백엔드의 OFFICE_AUTOMATION_WORKER_API_KEY 와 같은 값이어야 합니다.
WORKER_API_KEY=replace-with-a-long-random-string

# LLM. 백엔드와 따로 읽습니다(백엔드는 OFFICE_AI_NEWS_OPEN_AI_API_KEY).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo
INSTAGRAM_TOON_MODEL=gpt-5.6-luna

# 네이버 블로그 발행. True 로 바꾸기 전까지 로그인·발행을 시도하지 않습니다.
NAVER_LOGIN_ENABLED=False
NAVER_ID=
NAVER_PASSWORD=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 스케줄 (HH:MM)
KEYWORD_COLLECTION_TIME=09:00
CONTENT_GENERATION_TIME=09:30
POSTING_TIME=10:00

# 콘텐츠·키워드 기준
MIN_CONTENT_LENGTH=1500
MAX_CONTENT_LENGTH=3000
MIN_SEARCH_VOLUME=100
MAX_KEYWORDS_PER_DAY=10

# Selenium (컨테이너에서는 headless 필수)
SELENIUM_HEADLESS=True
SELENIUM_WAIT_TIME=10

# 재시도·로깅
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=5
LOG_LEVEL=INFO

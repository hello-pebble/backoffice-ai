# 이 파일을 config/.env 로 복사한 뒤 값을 채우세요. 실제 비밀값은 절대 커밋하지 않습니다.
# [외부 연동] 표시가 있는 항목은 실제 외부 API를 연결할 때만 채우면 됩니다.
# 연동 절차는 docs/EXTERNAL_API_SETUP.md 를 참고하세요.

# ─────────────────────────────────────────────
# 백엔드(Spring) - 인증
# APP_AUTH_ENABLED=true 인데 APP_AUTH_API_KEY 가 비어 있으면 앱이 시작되지 않습니다.
# 로컬은 false, 배포(Railway/OCI)는 true 로 둡니다.
# ─────────────────────────────────────────────
APP_AUTH_ENABLED=false
APP_AUTH_API_KEY=
# 프런트엔드 도메인. 쉼표로 구분합니다.
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8765

# ─────────────────────────────────────────────
# 백엔드(Spring) - Gmail 연동 [외부 연동]
# credentials 파일은 data/office-dashboard/gmail-credentials.json 에 둡니다.
# REDIRECT_URI 는 Google Cloud 콘솔에 등록한 값과 정확히 같아야 합니다.
# ─────────────────────────────────────────────
OFFICE_GMAIL_ENABLED=false
OFFICE_GMAIL_REDIRECT_URI=http://127.0.0.1:8765/api/gmail/callback
# 배포용: 다운로드한 클라이언트 JSON 원문을 한 줄로 넣습니다.
# 값이 있으면 credentials 파일보다 우선합니다. 로컬은 비워두고 파일을 쓰세요.
OFFICE_GMAIL_CREDENTIALS_JSON=

# ─────────────────────────────────────────────
# 백엔드(Spring) - 토스증권 Open API [외부 연동]
# ─────────────────────────────────────────────
OFFICE_TOSS_ENABLED=false
OFFICE_TOSS_BASE_URL=https://openapi.tossinvest.com
OFFICE_TOSS_CLIENT_ID=
OFFICE_TOSS_CLIENT_SECRET=
OFFICE_TOSS_WATCHLIST=005930,000660,373220

# ─────────────────────────────────────────────
# 데이터베이스(Supabase) - Kotlin은 JDBC URL, Python은 DSN을 사용합니다.
# SUPABASE_PG_DSN 을 비워두면 SUPABASE_DB_URL 에서 jdbc: 접두어를 떼고 사용합니다.
# ─────────────────────────────────────────────
SUPABASE_DB_URL=jdbc:postgresql://localhost:5432/backoffice
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=replace-with-the-database-password
SUPABASE_PG_DSN=

# ─────────────────────────────────────────────
# 자동화(Python) - 네이버 블로그 [외부 연동]
# NAVER_LOGIN_ENABLED=False 인 동안에는 로그인·발행을 시도하지 않습니다.
# 실제 발행은 검토 후 직접 True 로 바꿀 때만 동작합니다.
# ─────────────────────────────────────────────
NAVER_LOGIN_ENABLED=False
NAVER_ID=
NAVER_PASSWORD=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─────────────────────────────────────────────
# 자동화(Python) - OpenAI [외부 연동, 과금 발생]
# ─────────────────────────────────────────────
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
# 인스타툰 대본 생성 기본 모델
INSTAGRAM_TOON_MODEL=gpt-5.6-luna

# ─────────────────────────────────────────────
# 로깅
# ─────────────────────────────────────────────
LOG_LEVEL=INFO

# ─────────────────────────────────────────────
# 스케줄링 (HH:MM)
# ─────────────────────────────────────────────
KEYWORD_COLLECTION_TIME=09:00
CONTENT_GENERATION_TIME=09:30
POSTING_TIME=10:00

# ─────────────────────────────────────────────
# 콘텐츠 생성
# ─────────────────────────────────────────────
MIN_CONTENT_LENGTH=1500
MAX_CONTENT_LENGTH=3000

# ─────────────────────────────────────────────
# 키워드 수집
# ─────────────────────────────────────────────
MIN_SEARCH_VOLUME=100
MAX_KEYWORDS_PER_DAY=10

# ─────────────────────────────────────────────
# Selenium
# ─────────────────────────────────────────────
SELENIUM_HEADLESS=False
SELENIUM_WAIT_TIME=10

# ─────────────────────────────────────────────
# 재시도
# ─────────────────────────────────────────────
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=5



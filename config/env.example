# OpenAI API 설정
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
# 인스타툰 대본 생성 기본 모델 (API 과금 필요)
INSTAGRAM_TOON_MODEL=gpt-5.6-luna

# 네이버 API 설정
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# 네이버 블로그 계정 정보
NAVER_ID=your_naver_id_here
NAVER_PASSWORD=your_naver_password_here

# 로깅 설정
LOG_LEVEL=INFO

# 스케줄링 설정 (HH:MM 형식)
KEYWORD_COLLECTION_TIME=09:00
CONTENT_GENERATION_TIME=09:30
POSTING_TIME=10:00

# 콘텐츠 생성 설정
MIN_CONTENT_LENGTH=1500
MAX_CONTENT_LENGTH=3000

# 키워드 수집 설정
MIN_SEARCH_VOLUME=100
MAX_KEYWORDS_PER_DAY=10

# Selenium 설정
SELENIUM_HEADLESS=False
SELENIUM_WAIT_TIME=10

# 재시도 설정
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=5

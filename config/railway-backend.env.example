# Railway → backoffice-api 서비스 → Variables → Raw Editor 에 붙여 넣는 값입니다.
# 이 파일을 config/railway-backend.env 로 복사해 값을 채운 뒤 붙여 넣으세요(복사본은 커밋되지 않습니다).
# 붙여 넣기가 주석에서 막히면 # 줄을 지우고 다시 시도하세요.
#
# 배포 프로파일(application-oci.yml)에 기본값이 있는 항목은 여기서 뺐습니다.
# 기본값을 바꿔야 할 때만 docs/SETUP_REGISTRY.md 를 보고 추가하세요.

SPRING_PROFILES_ACTIVE=oci
APP_CORS_ALLOWED_ORIGINS=https://backoffice-ai-orpin.vercel.app

# 데이터베이스(Supabase)
SUPABASE_DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.<project-reference>
SUPABASE_DB_PASSWORD=replace-with-the-database-password
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_VERSION=0

# 로그인. 비어 있으면 아무도 로그인할 수 없습니다.
# 리디렉션 주소는 Railway 가 아니라 Vercel 도메인이어야 합니다(vercel.json 이 /api 를 프록시).
OFFICE_AUTH_ALLOWED_EMAILS=replace-with-the-owner-email

# Slack 앱 OAuth
OFFICE_SLACK_CLIENT_ID=
OFFICE_SLACK_CLIENT_SECRET=

# 워커 → 백엔드 저장에 쓰는 공유 키. 워커 서비스의 WORKER_API_KEY 와 같은 값이어야 합니다.
# 비어 있으면 워커 요청이 전부 401 로 막히고 자동화 결과가 저장되지 않습니다.
OFFICE_AUTOMATION_WORKER_API_KEY=replace-with-a-long-random-string

# 백엔드는 Python 을 직접 실행하지 않습니다. 자동화는 워커 서비스가 담당합니다.
OFFICE_AUTOMATION_EXECUTION_ENABLED=false

# AI 브리핑·대본 생성 (Railway 에는 ollama 가 없으므로 openai 로 둡니다)
OFFICE_AI_NEWS_SUMMARY_PROVIDER=openai
OFFICE_AI_NEWS_OPEN_AI_API_KEY=
OFFICE_AI_NEWS_SUMMARY_MODEL=

# Gmail. 리디렉션 주소는 이미 등록된 Railway 주소를 그대로 씁니다(쿠키를 쓰지 않는 흐름).
OFFICE_GMAIL_ENABLED=false
OFFICE_GMAIL_REDIRECT_URI=https://backoffice-ai-production.up.railway.app/api/gmail/callback
OFFICE_GMAIL_CREDENTIALS_JSON=

# 토스증권
OFFICE_TOSS_ENABLED=false
OFFICE_TOSS_CLIENT_ID=
OFFICE_TOSS_CLIENT_SECRET=
OFFICE_TOSS_WATCHLIST=005930,000660,373220

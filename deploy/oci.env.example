# NOTE: 현재 실제 배포는 Railway 입니다. Railway 는 이 파일을 읽지 않고 대시보드 변수를 씁니다.
# 등록해야 할 값의 최신 목록은 docs/SETUP_REGISTRY.md 를 보세요.
# 이 파일은 OCI VM(compose.yaml) 경로를 위해 남겨 둡니다.

# Supabase Session Pooler. Keep the actual password only in deploy/oci.env or OCI Vault.
SUPABASE_DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.<project-reference>
SUPABASE_DB_PASSWORD=replace-with-the-database-password
SUPABASE_DB_POOL_SIZE=5
SUPABASE_DB_MIN_IDLE=1

# Google login. Reuses the Gmail OAuth client; add the redirect URI in the Google console.
# Nobody can sign in while OFFICE_AUTH_ALLOWED_EMAILS is empty.
# On Railway the frontend proxies /api/* to the backend, so the cookie is same-site (Lax).
# On a bare OCI VM with a separate frontend domain it must be SameSite=None; Secure.
OFFICE_AUTH_ENABLED=true
OFFICE_AUTH_ALLOWED_EMAILS=replace-with-the-owner-email
OFFICE_AUTH_REDIRECT_URI=https://<api-domain>/api/auth/callback
OFFICE_AUTH_SUCCESS_REDIRECT=https://backoffice-ai-orpin.vercel.app/
OFFICE_AUTH_COOKIE_SECURE=true
OFFICE_AUTH_COOKIE_SAME_SITE=Lax

# Slack app OAuth. Install from the dashboard button; the bot token is stored in the database.
OFFICE_SLACK_CLIENT_ID=
OFFICE_SLACK_CLIENT_SECRET=
OFFICE_SLACK_REDIRECT_URI=https://<api-domain>/api/slack/callback
OFFICE_SLACK_REVIEW_BASE_URL=https://backoffice-ai-orpin.vercel.app

# The Vercel production URL. Add preview URLs explicitly only when needed.
APP_CORS_ALLOWED_ORIGINS=https://backoffice-ai-orpin.vercel.app

# Kotlin API integrations. See docs/EXTERNAL_API_SETUP.md
OFFICE_TOSS_ENABLED=false
OFFICE_TOSS_BASE_URL=https://openapi.tossinvest.com
OFFICE_TOSS_CLIENT_ID=
OFFICE_TOSS_CLIENT_SECRET=
OFFICE_TOSS_WATCHLIST=005930,000660,373220
OFFICE_AI_NEWS_SUMMARY_PROVIDER=openai
OFFICE_AI_NEWS_OPEN_AI_API_KEY=
OFFICE_AI_NEWS_SUMMARY_MODEL=gpt-5.6-luna
# Google sign-in also grants gmail.readonly, so there is no separate Gmail callback to register.
OFFICE_GMAIL_ENABLED=false
# Paste the downloaded OAuth client JSON as a single line. Takes precedence over the file path.
OFFICE_GMAIL_CREDENTIALS_JSON=

# Python worker integrations
OPENAI_API_KEY=
# OpenAI-compatible endpoint. Leave empty for OpenAI itself.
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=gpt-3.5-turbo
INSTAGRAM_TOON_MODEL=gpt-5.6-luna
# Real publishing stays off until this is explicitly set to True.
NAVER_LOGIN_ENABLED=False
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_ID=
NAVER_PASSWORD=
LOG_LEVEL=INFO
KEYWORD_COLLECTION_TIME=09:00
CONTENT_GENERATION_TIME=09:30
POSTING_TIME=10:00
SELENIUM_HEADLESS=true
SELENIUM_WAIT_TIME=10
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=5



# Worker service
WORKER_API_KEY=replace-with-a-long-random-string
WORKER_RUN_TIMEOUT_SECONDS=900
OFFICE_AUTOMATION_EXECUTION_ENABLED=true
OFFICE_AUTOMATION_WORKER_URL=http://${{backoffice-worker.RAILWAY_PRIVATE_DOMAIN}}:${{backoffice-worker.PORT}}
OFFICE_AUTOMATION_WORKER_API_KEY=replace-with-the-same-worker-key



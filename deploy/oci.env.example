# Supabase Session Pooler. Keep the actual password only in deploy/oci.env or OCI Vault.
SUPABASE_DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.<project-reference>
SUPABASE_DB_PASSWORD=replace-with-the-database-password
SUPABASE_DB_POOL_SIZE=5
SUPABASE_DB_MIN_IDLE=1

# The Vercel production URL. Add preview URLs explicitly only when needed.
APP_CORS_ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app

# Kotlin API integrations
OFFICE_TOSS_CLIENT_ID=
OFFICE_TOSS_CLIENT_SECRET=
OFFICE_TOSS_WATCHLIST=005930,000660,373220
OFFICE_AI_NEWS_SUMMARY_PROVIDER=openai
OFFICE_AI_NEWS_OPEN_AI_API_KEY=
OFFICE_AI_NEWS_SUMMARY_MODEL=gpt-5.6-luna

# Python worker integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
INSTAGRAM_TOON_MODEL=gpt-5.6-luna
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_ID=
NAVER_PASSWORD=
LOG_LEVEL=INFO
KEYWORD_COLLECTION_TIME=09:00
CONTENT_GENERATION_TIME=09:30
POSTING_TIME=10:00
SELENIUM_HEADLESS=true
SELENIUM_WAIT_TIME=10
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=5
